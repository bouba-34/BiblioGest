<Window x:Class="BiblioGest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BiblioGest"
        xmlns:views="clr-namespace:BiblioGest.Views"
        xmlns:vm="clr-namespace:BiblioGest.ViewModels"
        xmlns:converters="clr-namespace:BiblioGest.Converters"
        mc:Ignorable="d"
        Title="BiblioGest - Système de Gestion de Bibliothèque" 
        Height="700" 
        Width="1000" 
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    
    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <local:BooleanToNumberConverter x:Key="BooleanToNumberConverter" 
                                       TrueValue="1" 
                                       FalseValue="0" />
        
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        
        <!-- Menu button style -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="20,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="220" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryColor}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- DataTemplates for ViewModels -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:BookViewModel}">
            <views:BookView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:MemberViewModel}">
            <views:MemberView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:LoanViewModel}">
            <views:LoanView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:UserAdminViewModel}">
            <views:UserAdminView />
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left sidebar menu -->
        <Grid Grid.Column="0" Background="{StaticResource PrimaryDarkBrush}" Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="120" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            
            <!-- Logo and app title -->
            <StackPanel Grid.Row="0" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="BiblioGest" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="Gestion de Bibliothèque" FontSize="12" Foreground="#BBDEFB" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="{Binding CurrentUser.FullName, StringFormat='Bienvenue, {0}'}" FontSize="12" Foreground="White" HorizontalAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
            
            <!-- Navigation menu -->
            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <Button Command="{Binding NavigateToHomeCommand}" Style="{StaticResource MenuButton}" Content="Tableau de bord" />
                <Button Command="{Binding NavigateToBooksCommand}" Style="{StaticResource MenuButton}" Content="Livres" />
                <Button Command="{Binding NavigateToMembersCommand}" Style="{StaticResource MenuButton}" Content="Adhérents" />
                <Button Command="{Binding NavigateToLoansCommand}" Style="{StaticResource MenuButton}" Content="Emprunts" />
                <Button Command="{Binding NavigateToSearchCommand}" Style="{StaticResource MenuButton}" Content="Recherche" />
                
                <!-- Admin button - only visible for admin users -->
                <Button Command="{Binding NavigateToUserAdminCommand}" 
                        Style="{StaticResource MenuButton}" 
                        Content="Gestion Utilisateurs" 
                        Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            
            <!-- Status and Logout -->
            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                <TextBlock Text="{Binding StatusMessage}" 
                           Foreground="#BBDEFB" 
                           FontSize="10" 
                           TextWrapping="Wrap"
                           Margin="10,0,10,10"
                           TextAlignment="Center"/>
                           
                <Button Command="{Binding LogoutCommand}" Style="{StaticResource MenuButton}" Content="Déconnexion" />
            </StackPanel>
        </Grid>
        
        <!-- Login view (quand pas connecté) -->
        <ContentControl 
            Grid.ColumnSpan="2" 
            Content="{Binding CurrentViewModel}" 
            Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        
        <!-- Main content area -->
        <ContentControl 
            Grid.Column="1" 
            Content="{Binding CurrentViewModel}" 
            Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
    
</Window>