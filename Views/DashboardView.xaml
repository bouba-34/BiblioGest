<UserControl x:Class="BiblioGest.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BiblioGest.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    
    <Grid Background="#F5F5F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <!-- Page Title -->
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
                
                <!-- Stats Cards -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Total Books Card -->
                    <Border Grid.Column="0" 
                            Background="White" 
                            CornerRadius="8" 
                            Margin="0,0,10,0" 
                            Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#20000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total Books" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       FontSize="14"/>
                            <TextBlock Text="{Binding TotalBooks}" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontSize="32" 
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Total Members Card -->
                    <Border Grid.Column="1" 
                            Background="White" 
                            CornerRadius="8" 
                            Margin="10,0" 
                            Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#20000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Total Members" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       FontSize="14"/>
                            <TextBlock Text="{Binding TotalMembers}" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontSize="32" 
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Active Loans Card -->
                    <Border Grid.Column="2" 
                            Background="White" 
                            CornerRadius="8" 
                            Margin="10,0" 
                            Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#20000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Active Loans" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       FontSize="14"/>
                            <TextBlock Text="{Binding ActiveLoans}" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       FontSize="32" 
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Overdue Loans Card -->
                    <Border Grid.Column="3" 
                            Background="White" 
                            CornerRadius="8" 
                            Margin="10,0,0,0" 
                            Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#20000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Overdue Loans" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       FontSize="14"/>
                            <TextBlock Text="{Binding OverdueLoans}" 
                                       Foreground="{StaticResource AccentBrush}" 
                                       FontSize="32" 
                                       FontWeight="SemiBold"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Recent Loans Section -->
                <TextBlock Text="Recent Loans" Style="{StaticResource SectionTitle}" Margin="0,20,0,10"/>
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#20000000"/>
                    </Border.Effect>
                    <DataGrid ItemsSource="{Binding RecentLoans}" 
                              AutoGenerateColumns="False" 
                              Style="{StaticResource DataGridStyle}"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Book" 
                                                Binding="{Binding Book.Title}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Member" 
                                                Binding="{Binding Member.FullName}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Loan Date" 
                                                Binding="{Binding LoanDate, StringFormat={}{0:yyyy-MM-dd}}" 
                                                Width="Auto"/>
                            <DataGridTextColumn Header="Due Date" 
                                                Binding="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd}}" 
                                                Width="Auto"/>
                            <DataGridTemplateColumn Header="Status" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReturned}" Value="True">
                                                            <Setter Property="Text" Value="Returned" />
                                                            <Setter Property="Foreground" Value="Green" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Text" Value="Overdue" />
                                                            <Setter Property="Foreground" Value="Red" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsReturned}" Value="False" />
                                                                <Condition Binding="{Binding IsOverdue}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="Active" />
                                                            <Setter Property="Foreground" Value="Blue" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                
                <!-- Popular Books Section -->
                <TextBlock Text="Popular Books" Style="{StaticResource SectionTitle}" Margin="0,20,0,10"/>
                <Border Background="White" CornerRadius="8" Padding="16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#20000000"/>
                    </Border.Effect>
                    <DataGrid ItemsSource="{Binding PopularBooks}" 
                              AutoGenerateColumns="False" 
                              Style="{StaticResource DataGridStyle}"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Title" 
                                                Binding="{Binding Title}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="Author" 
                                                Binding="{Binding Author}" 
                                                Width="*"/>
                            <DataGridTextColumn Header="ISBN" 
                                                Binding="{Binding ISBN}" 
                                                Width="Auto"/>
                            <DataGridTextColumn Header="Category" 
                                                Binding="{Binding Category.Name}" 
                                                Width="Auto"/>
                            <DataGridTextColumn Header="Copies Available" 
                                                Binding="{Binding CopiesAvailable}" 
                                                Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>