<UserControl x:Class="BiblioGest.Views.LoanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BiblioGest.Views"
             xmlns:biblioGest="clr-namespace:BiblioGest"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,20,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Loan Management" Style="{StaticResource PageTitle}"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="250" 
                         Margin="0,0,10,0" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         biblioGest:PlaceholderTextExtension.PlaceholderText="Search loans..."
                         VerticalContentAlignment="Center"/>
                         
                <Button Content="New Loan" 
                        Style="{StaticResource DefaultButton}"
                        Command="{Binding AddLoanCommand}"/>
            </StackPanel>
        </Grid>
        
        <!-- Filters -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,10,20,0">
            <CheckBox Content="Show only active loans" 
                      IsChecked="{Binding ShowOnlyActive}"
                      Margin="0,0,20,0"
                      VerticalAlignment="Center"/>
                      
            <CheckBox Content="Show only overdue loans" 
                      IsChecked="{Binding ShowOnlyOverdue}"
                      VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- Content -->
        <Grid Grid.Row="2" Margin="20,10,20,20">
            <!-- Loans List (when not in add mode) -->
            <Border Background="White" 
                    CornerRadius="8" 
                    Visibility="{Binding IsAddMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#20000000"/>
                </Border.Effect>
                
                <Grid>
                    <DataGrid ItemsSource="{Binding Loans}"
                              SelectedItem="{Binding SelectedLoan}"
                              Style="{StaticResource DataGridStyle}"
                              Margin="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Book" Binding="{Binding Book.Title}" Width="*"/>
                            <DataGridTextColumn Header="ISBN" Binding="{Binding Book.ISBN}" Width="120"/>
                            <DataGridTextColumn Header="Member" Binding="{Binding Member.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Loan Date" Binding="{Binding LoanDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                            <DataGridTextColumn Header="Return Date" Binding="{Binding ReturnDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                            <DataGridTemplateColumn Header="Status" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReturned}" Value="True">
                                                            <Setter Property="Text" Value="Returned" />
                                                            <Setter Property="Foreground" Value="Green" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Text" Value="Overdue" />
                                                            <Setter Property="Foreground" Value="Red" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsReturned}" Value="False" />
                                                                <Condition Binding="{Binding IsOverdue}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Text" Value="Active" />
                                                            <Setter Property="Foreground" Value="Blue" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" 
                                                    Command="{Binding DataContext.ReturnBookCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsReturned, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <TextBlock Text="✅" FontSize="16" ToolTip="Return Book"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" 
                                                    Command="{Binding DataContext.ExtendLoanCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsReturned, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <TextBlock Text="🕒" FontSize="16" ToolTip="Extend Loan"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            
            <!-- Add New Loan Form -->
            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="20"
                    Visibility="{Binding IsAddMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#20000000"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                               Text="New Loan"
                               Style="{StaticResource SectionTitle}"/>
                    
                    <Grid Grid.Row="1" Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Book Selection -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="Book" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AvailableBooks}"
                                      DisplayMemberPath="Title"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding NewLoan.BookId}"/>
                        </StackPanel>
                        
                        <!-- Member Selection -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                            <TextBlock Text="Member" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding ActiveMembers}"
                                      DisplayMemberPath="FullName"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding NewLoan.MemberId}"/>
                        </StackPanel>
                        
                        <!-- Loan Information -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                            <TextBlock Text="The loan will be created with the following details:" Margin="0,0,0,10"/>
                            <TextBlock Text="• Loan Date: Today" Margin="20,0,0,5"/>
                            <TextBlock Text="• Due Date: 14 days from today" Margin="20,0,0,5"/>
                            <TextBlock Text="• Status: Active" Margin="20,0,0,5"/>
                        </StackPanel>
                    </Grid>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" 
                                Style="{StaticResource DefaultButton}"
                                Background="Gray"
                                Command="{Binding CancelAddCommand}"
                                Margin="0,0,10,0"/>
                                
                        <Button Content="Create Loan" 
                                Style="{StaticResource DefaultButton}"
                                Command="{Binding CreateLoanCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    
    
</UserControl>
