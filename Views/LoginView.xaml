<UserControl x:Class="BiblioGest.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BiblioGest.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    
    <UserControl.Resources>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Background="White">
        <Border Width="400" 
                Height="400" 
                Background="White" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2" />
            </Border.Effect>
            
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Login title -->
                <TextBlock Grid.Row="0" 
                           Text="BiblioGest" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource PrimaryBrush}"/>
                
                <TextBlock Grid.Row="1" 
                           Text="Système de Gestion de Bibliothèque" 
                           FontSize="14" 
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,30"/>
                
                <!-- Username field -->
                <StackPanel Grid.Row="2" Margin="0,10">
                    <TextBlock Text="Nom d'utilisateur" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="10,8"/>
                </StackPanel>
                
                <!-- Password field -->
                <StackPanel Grid.Row="3" Margin="0,10">
                    <TextBlock Text="Mot de passe" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox" 
                                 Padding="10,8"/>
                </StackPanel>
                
                <!-- Remember me checkbox -->
                <CheckBox Grid.Row="4" 
                          Content="Se souvenir de moi" 
                          IsChecked="{Binding RememberMe}"
                          Margin="0,10,0,0"/>
                
                <!-- Error message -->
                <TextBlock Grid.Row="5" 
                           Text="{Binding ErrorMessage}" 
                           Foreground="Red" 
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                
                <!-- Login button -->
                <Button Grid.Row="6" 
                        Content="Connexion" 
                        Style="{StaticResource DefaultButton}"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}"
                        Margin="0,20,0,0"
                        Width="150"
                        VerticalAlignment="Top"/>
                
                <!-- Login instructions -->
                <TextBlock Grid.Row="7" 
                           Text="Utilisateurs par défaut: &#x0a;- admin/admin (administrateur)&#x0a;- user/user (utilisateur standard)" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Bottom"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,20,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>