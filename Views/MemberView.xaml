<UserControl x:Class="BiblioGest.Views.MemberView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BiblioGest.Views"
             xmlns:biblioGest="clr-namespace:BiblioGest"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <local:BooleanToStringConverter x:Key="BooleanToStringConverter"/>
        <local:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,20,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Member Management" Style="{StaticResource PageTitle}"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="250" 
                         Margin="0,0,10,0" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         biblioGest:PlaceholderTextExtension.PlaceholderText="Search members..."
                         VerticalContentAlignment="Center"/>
                         
                <Button Content="Add New Member" 
                        Style="{StaticResource DefaultButton}"
                        Command="{Binding AddMemberCommand}"/>
            </StackPanel>
        </Grid>
        
        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <!-- Main Grid with two columns when in detail view -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Members List (when not in edit/add mode) -->
                <Border Grid.Column="0" 
                        Background="White" 
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEditMode}" Value="False"/>
                                        <Condition Binding="{Binding IsAddMode}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#20000000"/>
                    </Border.Effect>
                    
                    <DataGrid ItemsSource="{Binding Members}"
                              SelectedItem="{Binding SelectedMember}"
                              Style="{StaticResource DataGridStyle}"
                              Margin="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
                            <DataGridTextColumn Header="Registration Date" Binding="{Binding RegistrationDate, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                            <DataGridTemplateColumn Header="Status" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Active;Inactive'}"
                                                  Foreground="{Binding IsActive, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='Green;Red'}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" 
                                                    Command="{Binding DataContext.ToggleStatusCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='❌;✅'}" 
                                                          FontSize="16"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" 
                                                    Command="{Binding DataContext.DeleteMemberCommand, 
                                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="🗑️" FontSize="16"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                
                <!-- Member Loans Panel (when member is selected but not in edit/add mode) -->
                <Border Grid.Column="1" 
                        Background="White" 
                        CornerRadius="8" 
                        Margin="10,0,0,0"
                        Width="380">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMember}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#20000000"/>
                    </Border.Effect>
                    
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" 
                                   Text="{Binding SelectedMember.FullName, StringFormat=Member Details: {0}}" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,16"/>
                        
                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="{Binding SelectedMember.Address}" 
                                       TextWrapping="Wrap" 
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedMember.Email}" 
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedMember.Phone}" 
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedMember.RegistrationDate, StringFormat=Registered: {0:yyyy-MM-dd}}" 
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedMember.IsActive, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Status: Active;Status: Inactive'}"
                                      Foreground="{Binding SelectedMember.IsActive, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='Green;Red'}"
                                      Margin="0,0,0,4"/>
                        </StackPanel>
                        
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" 
                                       Text="Loan History" 
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,8"/>
                            
                            <ListView Grid.Row="1" 
                                      ItemsSource="{Binding MemberLoans}" 
                                      BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource DividerBrush}" 
                                                BorderThickness="0,0,0,1" 
                                                Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Book.Title}" 
                                                               FontWeight="SemiBold" 
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding LoanDate, StringFormat=Borrowed: {0:yyyy-MM-dd}}" 
                                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                                               FontSize="12"/>
                                                    <TextBlock Text="{Binding DueDate, StringFormat=Due: {0:yyyy-MM-dd}}" 
                                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                                               FontSize="12"/>
                                                </StackPanel>
                                                
                                                <TextBlock Grid.Column="1" 
                                                          VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReturned}" Value="True">
                                                                    <Setter Property="Text" Value="Returned" />
                                                                    <Setter Property="Foreground" Value="Green" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                    <Setter Property="Text" Value="Overdue" />
                                                                    <Setter Property="Foreground" Value="Red" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsReturned}" Value="False" />
                                                                        <Condition Binding="{Binding IsOverdue}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Text" Value="Active" />
                                                                    <Setter Property="Foreground" Value="Blue" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>
                
                <!-- Edit/Add Form -->
                <Border Grid.Column="0" 
                        Grid.ColumnSpan="2"
                        Background="White" 
                        CornerRadius="8" 
                        Padding="20">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEditMode}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAddMode}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#20000000"/>
                    </Border.Effect>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" 
                                   Text="{Binding IsAddMode, Converter={StaticResource BooleanToStringConverter}, 
                                        ConverterParameter='Add New Member;Edit Member'}"
                                   Style="{StaticResource SectionTitle}"/>
                        
                        <Grid Grid.Row="1" Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- First Name -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="First Name" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewMember.FirstName}"/>
                            </StackPanel>
                            
                            <!-- Last Name -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                                <TextBlock Text="Last Name" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewMember.LastName}"/>
                            </StackPanel>
                            
                            <!-- Email -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,10,10">
                                <TextBlock Text="Email" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewMember.Email}"/>
                            </StackPanel>
                            
                            <!-- Phone -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,10,0,10">
                                <TextBlock Text="Phone" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewMember.Phone}"/>
                            </StackPanel>
                            
                            <!-- Address -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,10">
                                <TextBlock Text="Address" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding NewMember.Address}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            
                            <!-- Active Status -->
                            <CheckBox Grid.Row="3" Grid.Column="0" Content="Active" IsChecked="{Binding NewMember.IsActive}" Margin="0,10,0,0"/>
                        </Grid>
                        
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" 
                                    Style="{StaticResource DefaultButton}"
                                    Background="Gray"
                                    Command="{Binding CancelEditCommand}"
                                    Margin="0,0,10,0"/>
                                    
                            <Button Content="Save" 
                                    Style="{StaticResource DefaultButton}"
                                    Command="{Binding SaveMemberCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>