<UserControl x:Class="BiblioGest.Views.UserAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BiblioGest.Views"
             xmlns:biblioGest="clr-namespace:BiblioGest"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <local:BooleanToStringConverter x:Key="BooleanToStringConverter"/>
        <local:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
    </UserControl.Resources>
    
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,20,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Gestion des Utilisateurs" Style="{StaticResource PageTitle}"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox Width="250" 
                         Margin="0,0,10,0" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         biblioGest:PlaceholderTextExtension.PlaceholderText="Search users..."
                         VerticalContentAlignment="Center"/>
                         
                <Button Content="Ajouter Utilisateur" 
                        Style="{StaticResource DefaultButton}"
                        Command="{Binding AddUserCommand}"/>
            </StackPanel>
        </Grid>
        
        <!-- Content -->
        <Grid Grid.Row="1" Margin="20">
            <!-- DataGrid View (when not in edit/add mode) -->
            <Border Background="White" 
                    CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEditMode}" Value="False"/>
                                    <Condition Binding="{Binding IsAddMode}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#20000000"/>
                </Border.Effect>
                
                <DataGrid ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          Style="{StaticResource DataGridStyle}"
                          Margin="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Nom d'utilisateur" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="Nom complet" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                        <DataGridTextColumn Header="Date création" Binding="{Binding CreatedDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                        <DataGridTextColumn Header="Dernière connexion" Binding="{Binding LastLoginDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/>
                        <DataGridTemplateColumn Header="Rôle" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsAdmin, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Admin;Utilisateur'}"
                                               Foreground="{Binding IsAdmin, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='Blue;Black'}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Statut" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Actif;Inactif'}"
                                              Foreground="{Binding IsActive, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='Green;Red'}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" 
                                                Command="{Binding DataContext.ResetPasswordCommand, 
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Réinitialiser le mot de passe">
                                            <TextBlock Text="🔑" FontSize="16"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" 
                                                Command="{Binding DataContext.ToggleUserStatusCommand, 
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding IsActive, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Désactiver;Activer'}">
                                            <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='❌;✅'}" FontSize="16"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" 
                                                Command="{Binding DataContext.DeleteUserCommand, 
                                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Supprimer">
                                            <TextBlock Text="🗑️" FontSize="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            
            <!-- Edit/Add Form -->
            <Border Background="White" 
                    CornerRadius="8" 
                    Padding="20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#20000000"/>
                </Border.Effect>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                               Text="{Binding IsAddMode, Converter={StaticResource BooleanToStringConverter}, 
                                    ConverterParameter='Ajouter Nouvel Utilisateur;Modifier Utilisateur'}"
                               Style="{StaticResource SectionTitle}"/>
                    
                    <Grid Grid.Row="1" Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Nom d'utilisateur -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                            <TextBlock Text="Nom d'utilisateur" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewUser.Username}"
                                     IsEnabled="{Binding IsAddMode}"/>
                        </StackPanel>
                        
                        <!-- Mot de passe -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                            <TextBlock Text="{Binding IsAddMode, Converter={StaticResource BooleanToStringConverter}, 
                                        ConverterParameter='Mot de passe;Nouveau mot de passe (laisser vide pour ne pas changer)'}" 
                                       Margin="0,0,0,5"/>
                            <PasswordBox x:Name="PasswordBox" Margin="0"/>
                        </StackPanel>
                        
                        <!-- Nom complet -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,10,10">
                            <TextBlock Text="Nom complet" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewUser.FullName}"/>
                        </StackPanel>
                        
                        <!-- Email -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,10,0,10">
                            <TextBlock Text="Email" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding NewUser.Email}"/>
                        </StackPanel>
                        
                        <!-- Rôle Admin -->
                        <CheckBox Grid.Row="2" Grid.Column="0" Content="Administrateur" IsChecked="{Binding NewUser.IsAdmin}" Margin="0,10,0,0"/>
                        
                        <!-- Statut Actif -->
                        <CheckBox Grid.Row="2" Grid.Column="1" Content="Actif" IsChecked="{Binding NewUser.IsActive}" Margin="10,10,0,0"/>
                    </Grid>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" 
                                Style="{StaticResource DefaultButton}"
                                Background="Gray"
                                Command="{Binding CancelEditCommand}"
                                Margin="0,0,10,0"/>
                                
                        <Button Content="Enregistrer" 
                                Style="{StaticResource DefaultButton}"
                                Command="{Binding SaveUserCommand}"
                                CommandParameter="{Binding ElementName=PasswordBox}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>